                    <tr>
                        <td>Diagnóstico</td>
                        <td><span class="comando">show ip interface brief</span></td>
                        <td>Muestra resumen de interfaces IP</td>
                    </tr>
                    <tr>
                        <td>Diagnóstico</td>
                        <td><span class="comando">show ip route</span></td>
                        <td>Muestra tabla de enrutamiento</td>
                    </tr>
                    <tr>
                        <td>Configuración</td>
                        <td><span class="comando">configure terminal</span></td>
                        <td>Entra al modo de configuración</td>
